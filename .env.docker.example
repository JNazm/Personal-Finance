# Copy this file to .env.docker and fill in real values before running:
#   docker compose up -d --build
#
# .env.docker is read by the "app" service (Laravel) via env_file in docker-compose.yml,
# and DB_*/DOMAIN values are also reused directly by the "db" and "caddy" services.

# --- Your domain (bought on Namecheap) ---
# Point an A record for this domain (and www if desired) at your public IP,
# or use Namecheap Dynamic DNS / a DDNS client if your IP changes.
DOMAIN=nazmifinance.online

# The app is served under a path prefix, not the domain root, so this box
# can also host other things at "/" later. Caddy strips the prefix before
# forwarding to the app container (see docker/Caddyfile), so Laravel must
# be told the real public URL below to generate correct links/assets.
APP_NAME="Personal Finance"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://nazmifinance.online/personal-finance

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=personal_finance
DB_USERNAME=personal_finance
DB_PASSWORD=change-me-to-a-strong-password

CACHE_STORE=database
SESSION_DRIVER=cookie
SESSION_PATH=/personal-finance
SESSION_DOMAIN=nazmifinance.online
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database

# --- Only needed if using Cloudflare Tunnel instead of router port forwarding ---
# (e.g. your ISP places you behind CGNAT). See docs/SELF_HOSTING.md section 1b.
# Get this token from Cloudflare Zero Trust > Networks > Tunnels when creating a tunnel.
# CLOUDFLARE_TUNNEL_TOKEN=
